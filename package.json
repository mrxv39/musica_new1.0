{
  "name": "poker-boss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "npm run test:fast",
    "dev": "vite",
    "tauri": "tauri",
    "test:fast": "cross-env VITEST_MODE=fast vitest run",
    "build": "tsc && vite build",
    "test:slow": "cross-env VITEST_MODE=slow vitest run",
    "test:coverage": "cross-env VITEST_MODE=fast vitest run --coverage",
    "gate:coverage": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/gate-coverage-strategy.ps1",
    "preview": "vite preview",
    "gate:fast": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/gate-fast.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "jsdom": "^28.1.0",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^4.0.18",
    "vite": "^7.0.4",
    "vitest": "^4.0.18",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/react": "^16.3.2",
    "@tauri-apps/cli": "^2",
    "cross-env": "^7.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@types/react": "^19.1.8"
  }
}