{
  "name": "poker-boss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "npm run test:fast",
    "dev": "vite",
    "tauri": "tauri",
    "report:strategy": "python scripts/report_strategy_coverage_from_db.py",
    "report:ocr-effectiveness": "python scripts/report_ocr_effectiveness.py",
    "test:fast": "cross-env VITEST_MODE=fast vitest run",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test:slow": "cross-env VITEST_MODE=slow vitest run",
    "test:coverage": "cross-env VITEST_MODE=fast vitest run --coverage",
    "gate:coverage": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/gate-coverage-strategy.ps1",
    "preview": "vite preview",
    "gate:fast": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/gate-fast.ps1",
    "test:ui": "vitest run src/tests/ui_import_xml_payload.test.tsx"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^7.0.3",
    "jsdom": "^28.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  }
}
