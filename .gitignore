# =========================
# Node / Vite
# =========================
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# =========================
# Editor / OS
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.venv/
venv/

# =========================
# Rust / Tauri
# =========================
src-tauri/target/
**/target/

# =========================
# Local data / runtime artifacts
# =========================
data/
*.db
*.sqlite
*.sqlite3

# =========================
# Backups / tmp
# =========================
_backup_*/
*.bak_*

# =========================
# Cache folders inside modules/tests
# =========================
modules/**/__pycache__/
tests/**/__pycache__/

# =========================
# Media: NO ignorar assets del proyecto
# =========================
# Permitimos assets reales:
!public/**
!src-tauri/icons/**

# Ignorar solo screenshots/temporales típicos (root)
screenshot_*.bmp
screenshot_*.png
screenshot_*.jpg
screenshot_*.jpeg

# Si tienes carpetas concretas de capturas, ignóralas aquí (ejemplos):
# captures/
# screenshots/

# Mantener fixtures bmp de templates
!modules/preflop/templates/*.bmp
